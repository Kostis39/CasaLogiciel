# Fichier d'exemple pour les variables d'environnement de l'application
# Copiez ce fichier en .env et remplissez les valeurs appropriées
# Note: Utiliser pour la production et pour le dév !

# ===== DATABASE CONFIG =====
MARIADB_NAME=casabdd           # Nom de la base de données à créer
MARIADB_USER=root       # Nom d'utilisateur pour MariaDB (par défaut root)
MARIADB_PASSWORD=       # Défini un mot de passe pour MariaDB sera le même pour ce connecter à PhpMyadmin
MARIADB_PORT=3306       # Port sur lequel MariaDB écoute (par défaut 3306)

# ===== FRONTEND CONFIG =====
NEXT_PUBLIC_API_URL_PROD=   # Adresse Ip du serveur + port de l'API (normalement :5000)
NEXT_PUBLIC_PASSWORD=       # Défini un mot de passe pour l'application

# ===== METABASE CONFIG =====
NEXT_PUBLIC_METABASE_URL=   # Adresse Ip du serveur + port de Metabase normalement 4000

# ===== AUTHENTIFICATION API =====
# Secret utilisé par le backend pour signer les tokens (générez avec : openssl rand -hex 32)
AUTH_SECRET=
# CORS_ORIGINS: origine(s) du frontend autorisées à appeler l'API, séparées par des virgules
# Exemple: http://192.168.1.50:3000,https://casamur.mondomaine.fr
CORS_ORIGINS=

# Metabase : jeton du setup initial (une seule utilisation ; laisser vide ensuite)
METABASE_SETUP_TOKEN=
